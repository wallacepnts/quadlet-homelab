# Dashboard basic-auth user. The password is a podman secret; only the name
# lives here. Leaving both unset publishes the dashboard with no login at all —
# and the dashboard can run shell commands, so do not.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin

# CORS for the gateway on 8642. `*` is fine while only containers on this host
# call it; narrow it if you ever point a browser app at the API.
API_SERVER_CORS_ORIGINS=*

# Uncomment to keep `podman exec hermes-agent hermes ...` running as root.
# The default re-execs as the hermes user (UID 10000) so the files it writes
# under /opt/data stay readable by the supervised gateway.
# HERMES_DOCKER_EXEC_AS_ROOT=1

# Provider keys go through `hermes setup` into /opt/data, not here — the .env
# is a plain file in ~/.config/containers/env/. If you would rather set one
# directly, make it a podman secret and add a Secret= line to the unit.
