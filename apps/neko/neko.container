[Unit]
Description=neko (a browser in a container, streamed over WebRTC)

[Container]
NoNewPrivileges=true
PidsLimit=1024
DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETGID
AddCapability=SETUID
ShmSize=2g

Image=ghcr.io/m1k1o/neko/firefox:3.1.5
ContainerName=neko
Network=tsdproxy-net.network
PublishPort=8018:8080
PublishPort=59000:59000/udp
PublishPort=59000:59000/tcp

EnvironmentFile=%h/.config/containers/env/neko.env
Secret=neko-user-password,type=env,target=NEKO_MEMBER_MULTIUSER_USER_PASSWORD
Secret=neko-admin-password,type=env,target=NEKO_MEMBER_MULTIUSER_ADMIN_PASSWORD

HealthCmd=CMD-SHELL wget -q --spider http://127.0.0.1:8080/health || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=neko
Label=tsdproxy.port.web=443/https:8080/http
Label=tsdproxy.port.webrtc=59000/tcp:59000/tcp

Label=homepage.group=Tools
Label=homepage.name=neko
Label=homepage.icon=https://api.iconify.design/mdi/web-box.svg?color=%%23888888
Label=homepage.href=https://neko.${TAILNET}.ts.net
Label=homepage.description="A throwaway browser others can watch and share control of"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
