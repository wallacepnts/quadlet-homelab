NEKO_DESKTOP_SCREEN=1920x1080@30

# One port for all WebRTC instead of the 101-port range upstream's compose
# publishes. Both must be the same number as the PublishPort in the unit.
NEKO_WEBRTC_UDPMUX=59000
NEKO_WEBRTC_TCPMUX=59000
NEKO_WEBRTC_ICELITE=1

# The address clients use to reach the media port. Without it neko advertises
# the container's own IP, which nobody outside can route to — the page loads
# and the screen stays black. Use the host's tailnet or LAN address.
# NEKO_NAT1TO1=100.x.y.z
