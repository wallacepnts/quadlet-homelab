[Unit]
Description=Headplane (web interface for Headscale)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=32M
DropCapability=ALL
NoNewPrivileges=true
User=1000
PidsLimit=256

Image=ghcr.io/tale/headplane:0.7.0
ContainerName=headplane
Network=tsdproxy-net.network
PublishPort=8116:3000

Volume=%h/.config/containers/volumes/headplane/config/config.yaml:/etc/headplane/config.yaml:ro,Z
Volume=%h/.config/containers/volumes/headplane/data:/var/lib/headplane:Z
Volume=%h/.config/containers/volumes/headscale/config:/etc/headscale:ro,Z
Secret=headplane-cookie-secret,target=/run/secrets/cookie-secret

HealthCmd=CMD-SHELL /nodejs/bin/node -e "require('http').get('http://127.0.0.1:3000/admin/', r => process.exit(r.statusCode < 400 ? 0 : 1)).on('error', () => process.exit(1))" || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=homepage.group="Network & Security"
Label=homepage.name=Headplane
Label=homepage.icon=headscale.svg
Label=homepage.description="The web interface Headscale does not ship with"
Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
