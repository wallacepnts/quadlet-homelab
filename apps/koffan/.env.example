APP_ENV=production
PORT=8080

# The database, inside the volume. WAL is on, so the folder holds three files
# and the backup hook's sqlite mode copies them consistently.
DB_PATH=/data/shopping.db

# Called on every change, if you want the list to poke something else — the
# ntfy in this repository, for instance. Empty turns it off.
WEBHOOK_URL=
WEBHOOK_SECRET=
WEBHOOK_EVENTS=
