[Unit]
Description=ownCloud

[Container]
DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETUID
AddCapability=SETGID
AddCapability=NET_BIND_SERVICE
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
PidsLimit=256
Image=docker.io/owncloud/server:11.0.0-20260802
ContainerName=owncloud
Network=tsdproxy-net.network
PublishPort=8094:8080

Volume=%h/.config/containers/volumes/owncloud/data:/mnt/data:Z
EnvironmentFile=%h/.config/containers/env/owncloud.env
Secret=owncloud-admin-password,type=env,target=OWNCLOUD_ADMIN_PASSWORD
HealthCmd=CMD-SHELL /usr/bin/healthcheck || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=30s
Notify=healthy
Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=owncloud
Label=tsdproxy.port.web=443/https:8080/http
Label=homepage.group=Self-Hosted
Label=homepage.name=ownCloud
Label=homepage.icon=owncloud.svg
Label=homepage.href=https://owncloud.${TAILNET}.ts.net
Label=homepage.description="Cloud file sync and sharing (SQLite evaluation)"

Label=wud.watch=true

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
