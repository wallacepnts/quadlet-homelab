OWNCLOUD_DOMAIN=owncloud.<your-tailnet>.ts.net
OWNCLOUD_TRUSTED_DOMAINS=owncloud.<your-tailnet>.ts.net
OWNCLOUD_ADMIN_USERNAME=admin

# tsdproxy terminates TLS and forwards plain HTTP to the container — without
# this, ownCloud generates links and redirects as http:// (a CSRF error, see
# the README). Remove or change it if you will only access it locally via
# http://localhost:8094 instead of the tailnet.
OWNCLOUD_OVERWRITE_PROTOCOL=https
