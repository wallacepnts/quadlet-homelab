TZ=America/Sao_Paulo

# The image itself adjusts /data's owner to the internal uid (2999) on the
# first start — it needs this because the root filesystem is read-only and
# the volume is created by the host with a different owner.
TAKE_FILE_OWNERSHIP=true

# Optional settings for the birthday calendar hook (see the README) — the
# calendar's colour (without it, a random one is picked) and the reminder, in
# hours before midnight on the birthday.
# BIRTHDAY_CALENDAR_COLOR=4986e7
# BIRTHDAY_REMINDER_AT_HOUR=9
