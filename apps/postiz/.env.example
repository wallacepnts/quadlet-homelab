# Allows one sign-up, then closes the page. The first account is yours; without
# this, anyone who reaches the address can open another one.
DISABLE_REGISTRATION=true

# Instagram through a Facebook Business page. The same Meta app serves Facebook.
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=

# Instagram on its own, with no Facebook page. Needs a professional account.
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=

# Instagram downloads each image or video from a URL, so the file has to be
# reachable from the internet. On the tailnet it is not: use a public bucket.
# Uncomment all of them. The unit does not set STORAGE_PROVIDER, so this one wins.
# STORAGE_PROVIDER=cloudflare
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_ACCESS_KEY=
# CLOUDFLARE_SECRET_ACCESS_KEY=
# CLOUDFLARE_BUCKETNAME=
# CLOUDFLARE_BUCKET_URL=
# CLOUDFLARE_REGION=auto
