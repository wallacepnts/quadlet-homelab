[Unit]
Description=Postiz (social media scheduler)
After=postiz-postgres.service postiz-redis.service postiz-temporal.service
Requires=postiz-postgres.service postiz-redis.service postiz-temporal.service

[Container]
Image=ghcr.io/gitroomhq/postiz-app:v2.24.0
ContainerName=postiz

Network=tsdproxy-net.network
Network=postiz-net.network
PublishPort=8127:5000

Environment=MAIN_URL=https://postiz.${TAILNET}.ts.net
Environment=FRONTEND_URL=https://postiz.${TAILNET}.ts.net
Environment=NEXT_PUBLIC_BACKEND_URL=https://postiz.${TAILNET}.ts.net/api
Environment=BACKEND_INTERNAL_URL=http://localhost:3000
Environment=REDIS_URL=redis://postiz-redis:6379
Environment=TEMPORAL_ADDRESS=postiz-temporal:7233
Environment=IS_GENERAL=true
Environment=UPLOAD_DIRECTORY=/uploads
Environment=NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads
Environment=HOME=/home/postiz
EnvironmentFile=%h/.config/containers/env/postiz.env
Secret=postiz-database-url,type=env,target=DATABASE_URL
Secret=postiz-jwt-secret,type=env,target=JWT_SECRET

Volume=%h/.config/containers/volumes/postiz/uploads:/uploads:Z

ReadOnly=true
Tmpfs=/tmp:size=64M,mode=1777
Tmpfs=/run:size=8M,mode=1777
Tmpfs=/var/lib/nginx:size=1024M,mode=1777
Tmpfs=/var/log/nginx:size=16M,mode=1777
Tmpfs=/home/postiz:size=640M,mode=1777
DropCapability=ALL
User=33
PidsLimit=512
NoNewPrivileges=true

HealthCmd=["CMD", "node", "-e", "fetch('http://127.0.0.1:5000/api/auth/can-register').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=180s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=postiz
Label=tsdproxy.port.web=443/https:5000/http
Label=tsdproxy.dash.icon=mdi/calendar-share

Label=homepage.group=Productivity
Label=homepage.name=Postiz
Label=homepage.icon=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/postiz.svg
Label=homepage.href=https://postiz.${TAILNET}.ts.net
Label=homepage.description="Schedule posts to Instagram and other social networks"

Label=wud.watch=true
Label=wud.tag.include=^v[0-9]+[.][0-9]+[.][0-9]+$

[Service]
Restart=always
TimeoutStartSec=420

[Install]
WantedBy=default.target
