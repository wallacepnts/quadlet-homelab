[Unit]
Description=Postiz PostgreSQL

[Container]
Image=docker.io/library/postgres:17-alpine
ContainerName=postiz-postgres

Network=postiz-net.network

Environment=POSTGRES_USER=postiz-user
Environment=POSTGRES_DB=postiz
Secret=postiz-db-password,type=env,target=POSTGRES_PASSWORD

Volume=%h/.config/containers/volumes/postiz/postgres:/var/lib/postgresql/data:Z

ReadOnly=true
Tmpfs=/tmp:size=64M
Tmpfs=/run/postgresql:size=8M
DropCapability=ALL
User=70
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL pg_isready -U postiz-user -d postiz || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=12
HealthStartPeriod=30s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
