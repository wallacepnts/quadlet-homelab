[Unit]
Description=Postiz Temporal PostgreSQL

[Container]
Image=docker.io/library/postgres:16.15
ContainerName=postiz-temporal-postgres

Network=postiz-net.network

Environment=POSTGRES_USER=temporal
Secret=postiz-temporal-db-password,type=env,target=POSTGRES_PASSWORD

Volume=%h/.config/containers/volumes/postiz/temporal-postgres:/var/lib/postgresql/data:Z

ReadOnly=true
Tmpfs=/tmp:size=64M
Tmpfs=/var/run/postgresql:size=8M
DropCapability=ALL
User=999
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL pg_isready -U temporal || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=12
HealthStartPeriod=30s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
