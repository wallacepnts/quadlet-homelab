{
  "$schema": "../app-schema.json",
  "title": "Postiz",
  "short_desc": {
    "en": "Schedule your social media posts.",
    "pt": "Agende as suas publicações nas redes sociais."
  },
  "description": {
    "en": "Schedules posts to Instagram and other social networks, with a calendar and one place for every channel",
    "pt": "Agenda posts no Instagram e em outras redes sociais, com calendário e um só lugar para todos os canais"
  },
  "author": "gitroomhq",
  "source": "https://github.com/gitroomhq/postiz-app",
  "docs": "https://docs.postiz.com",
  "architectures": ["amd64", "arm64"],
  "category": "Productivity",
  "secrets": {
    "postiz-db-password": "rand-hex 24",
    "postiz-database-url": "shell printf 'postgresql://postiz-user:%s@postiz-postgres:5432/postiz' \"$(podman secret inspect --showsecret --format '{{.SecretData}}' postiz-db-password)\"",
    "postiz-temporal-db-password": "rand-hex 24",
    "postiz-jwt-secret": "rand-hex 32"
  },
  "config": { "nginx.conf": "%h/.config/containers/volumes/postiz/config/nginx.conf" },
  "units": {
    "postiz": { "image": "v{version}" },
    "postiz-postgres": { "upstream": "compose:gitroomhq/postiz-app:docker-compose.yaml" },
    "postiz-temporal": { "upstream": "compose:gitroomhq/postiz-app:docker-compose.yaml" },
    "postiz-temporal-postgres": { "upstream": "compose:gitroomhq/postiz-app:docker-compose.yaml" },
    "postiz-redis": { "upstream": "registry:^[0-9]+\\.[0-9]+\\.[0-9]+-alpine[0-9]+\\.[0-9]+$" }
  }
}
