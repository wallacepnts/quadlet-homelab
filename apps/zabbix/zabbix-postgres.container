[Unit]
Description=Zabbix PostgreSQL

[Container]
Image=docker.io/library/postgres:17.11-alpine
ContainerName=zabbix-postgres

Network=zabbix-net.network

Environment=POSTGRES_DB=zabbix
Environment=POSTGRES_USER=zabbix
Secret=zabbix-postgres-password,type=env,target=POSTGRES_PASSWORD

Volume=%h/.config/containers/volumes/zabbix/postgres:/var/lib/postgresql/data:Z

ReadOnly=true
Tmpfs=/tmp:size=64M
Tmpfs=/var/run/postgresql:size=16M
DropCapability=ALL
User=70
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL pg_isready -d zabbix -U zabbix
HealthInterval=5s
HealthTimeout=5s
HealthRetries=12
HealthStartPeriod=10s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
