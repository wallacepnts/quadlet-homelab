[Unit]
Description=Zabbix (monitoring web interface)
After=zabbix-server.service
Requires=zabbix-server.service

[Container]
Image=docker.io/zabbix/zabbix-web-nginx-pgsql:alpine-7.4.16
ContainerName=zabbix

Network=tsdproxy-net.network
Network=zabbix-net.network
PublishPort=8098:8080

Environment=DB_SERVER_HOST=zabbix-postgres
Environment=POSTGRES_DB=zabbix
Environment=POSTGRES_USER=zabbix
Environment=ZBX_SERVER_HOST=zabbix-server
Environment=PHP_TZ=America/Sao_Paulo
Secret=zabbix-postgres-password,type=env,target=POSTGRES_PASSWORD

Tmpfs=/tmp:size=64M
DropCapability=ALL
User=1997
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL wget -q -O /dev/null http://127.0.0.1:8080/ping || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=40s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=zabbix
Label=tsdproxy.port.web=443/https:8080/http
Label=tsdproxy.dash.icon=sh/zabbix

Label=homepage.group=Monitoring
Label=homepage.name=Zabbix
Label=homepage.icon=zabbix.svg
Label=homepage.href=https://zabbix.${TAILNET}.ts.net
Label=homepage.description="Enterprise-grade monitoring of servers, networks and services, with agents, SNMP, alerts and dashboards"

Label=wud.watch=true
Label=wud.tag.include=^alpine-[0-9]+[.][0-9]+[.][0-9]+$

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
