[Unit]
Description=Zabbix server (collects, evaluates and stores the monitoring data)
After=zabbix-postgres.service
Requires=zabbix-postgres.service

[Container]
Image=docker.io/zabbix/zabbix-server-pgsql
ContainerName=zabbix-server
RunInit=true

Network=zabbix-net.network
PublishPort=10051:10051

Environment=DB_SERVER_HOST=zabbix-postgres
Environment=POSTGRES_DB=zabbix
Environment=POSTGRES_USER=zabbix
Secret=zabbix-postgres-password,type=env,target=POSTGRES_PASSWORD

StopTimeout=30

ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
User=1997
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL nc -z 127.0.0.1 10051 || exit 1
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=120s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
