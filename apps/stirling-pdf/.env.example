# Login required — without it the UI is open to anyone who reaches the URL
# (the same model as the rest of the repo: a tailnet is not authentication).
DOCKER_ENABLE_SECURITY=true
SECURITY_ENABLE_LOGIN=true

# Language and OCR
DEFAULT_LOCALE=pt-BR
LANGS=pt_BR,en_US

# Heavy features off by default (book/advanced HTML pulls in large
# dependencies).
INSTALL_BOOK_AND_ADVANCED_HTML_OPS=false

# Analytics off. Since 3.0 the default (unset) makes the app ask the admin on
# first login; it sends PostHog and Scarf data when allowed. `false` here is the
# master switch — measured on 3.0.0: the app then reports enableAnalytics=false
# instead of null.
SYSTEM_ENABLEANALYTICS=false
