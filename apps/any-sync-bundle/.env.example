# The advertise address(es) clients should use (comma-separated). It is only
# read on the first start — after that, edit externalAddr in
# volumes/any-sync-bundle/data/bundle-config.yml (see Troubleshooting).
ANY_SYNC_BUNDLE_INIT_EXTERNAL_ADDRS=any-sync.<your-tailnet>.ts.net

# Storage limit per space, in bytes (default: 1 TiB)
# 1 GiB=1073741824  10 GiB=10737418240  150 GiB=161061273600  1 TiB=1099511627776  2 TiB=2199023255552
# ANY_SYNC_BUNDLE_INIT_FILENODE_DEFAULT_LIMIT=1099511627776
