[Unit]
Description=Anki sync server (self-hosted replacement for AnkiWeb sync)

[Container]
Image=docker.io/jeankhawand/anki-sync-server:26.08-distroless
ContainerName=anki
StopSignal=SIGINT

Network=tsdproxy-net.network
PublishPort=8125:8080

Environment=SYNC_HOST=0.0.0.0
Secret=anki-user,type=env,target=SYNC_USER1

Volume=%h/.config/containers/volumes/anki/data:/anki_data:Z

ReadOnly=true
DropCapability=ALL
User=65532
PidsLimit=256
NoNewPrivileges=true

HealthCmd=["anki-sync-server", "--healthcheck"]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=10s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=anki
Label=tsdproxy.port.web=443/https:8080/http
Label=tsdproxy.dash.icon=si/anki

Label=homepage.group=Productivity
Label=homepage.name=Anki
Label=homepage.icon=https://cdn.jsdelivr.net/gh/selfhst/icons/svg/anki.svg
Label=homepage.href=https://anki.${TAILNET}.ts.net
Label=homepage.description="Sync server for Anki flashcards, in place of AnkiWeb"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+[.][0-9]+-distroless$

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
