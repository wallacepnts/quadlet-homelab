[Unit]
Description=Beaver Habit Tracker

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
NoNewPrivileges=true
User=1000
PidsLimit=256

Image=docker.io/daya0576/beaverhabits:0.10.0
ContainerName=beaverhabits
Network=tsdproxy-net.network
PublishPort=8015:8080

Volume=%h/.config/containers/volumes/beaverhabits/data:/app/.user:Z
EnvironmentFile=%h/.config/containers/env/beaverhabits.env

HealthCmd=CMD-SHELL python -c "import urllib.request as u; u.urlopen('http://127.0.0.1:8080/health', timeout=5)" || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=20s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=habits
Label=tsdproxy.port.web=443/https:8080/http
Label=tsdproxy.dash.icon=mdi/check-circle-outline

Label=homepage.group=Personal
Label=homepage.name="Beaver Habits"
Label=homepage.icon=https://api.iconify.design/mdi/check-circle-outline.svg?color=%23888888
Label=homepage.href=https://habits.${TAILNET}.ts.net
Label=homepage.description="Habit tracking without goals — just the streak"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
