# Where the runner finds Gitea. Both sit on tsdproxy-net, so the container name
# resolves directly — no host port, and no round trip out through the tailnet
# and back for something running on the same machine.
GITEA_INSTANCE_URL=http://gitea:3000

# How this runner appears in Gitea's runner list.
GITEA_RUNNER_NAME=homelab

# Which `runs-on:` values this runner answers to, and the image each one means.
# Registering without this asks for ubuntu-latest and its siblings, and the
# first job then pulls a multi-gigabyte image built to look like a GitHub
# worker. Naming the images keeps that decision yours:
GITEA_RUNNER_LABELS=alpine:docker://docker.io/library/alpine:3,node:docker://docker.io/library/node:22-alpine

# Read once, at the first registration. After that the runner uses the .runner
# file in its volume, and changing the labels here does nothing until you
# delete that file and register again.
