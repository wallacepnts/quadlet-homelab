[Unit]
Description=Home Assistant

[Container]
ReadOnly=true
Tmpfs=/tmp:size=256M
DropCapability=ALL
PidsLimit=256
Image=ghcr.io/home-assistant/home-assistant:2026.8.1
ContainerName=home-assistant
Network=tsdproxy-net.network
PublishPort=8123:8123

Volume=%h/.config/containers/volumes/home-assistant/config:/config:Z
EnvironmentFile=%h/.config/containers/env/home-assistant.env

HealthCmd=CMD-SHELL wget -q --spider http://127.0.0.1:8123/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=60s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=home-assistant
Label=tsdproxy.port.web=443/https:8123/http

Label=homepage.group=Home
Label=homepage.name="Home Assistant"
Label=homepage.icon=home-assistant.svg
Label=homepage.href=https://home-assistant.${TAILNET}.ts.net
Label=homepage.description="Self-hosted home automation"
Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
