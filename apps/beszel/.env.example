# Hub — used in notification links; use the URL you actually reach the panel
# through (tsdproxy/tailnet).
APP_URL=https://beszel.<your-tailnet>.ts.net

# Agent — the hub and the agent are on the same host and connect over a
# shared socket (not TCP with a token exposed on the network) — see the
# README, "Installing from scratch".
HUB_URL=http://localhost:8090
LISTEN=/beszel_socket/beszel.sock
KEY_FILE=/run/secrets/beszel-key
TOKEN_FILE=/run/secrets/beszel-token
