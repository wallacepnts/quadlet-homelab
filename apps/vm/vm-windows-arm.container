[Unit]
Description=Windows on ARM in a container (QEMU/KVM)

[Container]
PidsLimit=512

# check: ignore ports — the same 8006/3389 as vm-windows on purpose. The two
# are mutually exclusive: this one installs ARM64 Windows, that one x64, and
# a host is one architecture or the other. They never run together.
Image=docker.io/dockurr/windows-arm:6.04
ContainerName=vm-windows-arm
Network=tsdproxy-net.network
PublishPort=8006:8006
PublishPort=3389:3389/tcp
PublishPort=3389:3389/udp

AddDevice=/dev/kvm
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN

Volume=%h/.config/containers/volumes/vm/windows-arm/storage:/storage:Z
EnvironmentFile=%h/.config/containers/env/vm-windows-arm.env
Secret=vm-windows-arm-password,type=env,target=PASSWORD

HealthCmd=CMD-SHELL curl -fsS -o /dev/null http://127.0.0.1:8006/ || exit 1
HealthInterval=60s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=300s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=windows-arm
Label=tsdproxy.port.web=443/https:8006/http
Label=tsdproxy.dash.icon=mdi/microsoft-windows

Label=homepage.group="Virtual Machines"
Label=homepage.name="Windows on ARM"
Label=homepage.icon=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/png/windows-11.png
Label=homepage.href=https://windows-arm.${TAILNET}.ts.net
Label=homepage.description="An ARM64 Windows VM, for an ARM host"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=600
TimeoutStopSec=120

[Install]
WantedBy=default.target
