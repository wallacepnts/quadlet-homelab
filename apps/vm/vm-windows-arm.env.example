# Which ARM64 Windows to install on first boot. Set by install.py, which asks.
# The list is shorter than x64's: no XP, Vista, 7 or Server, because none of
# them ever had an ARM64 build.
VERSION=11

# The VM's slice of the host. RAM_SIZE is reserved for the VM's whole
# lifetime, so leave the host enough to breathe.
RAM_SIZE=4G
CPU_CORES=2

# Virtual disk. It grows on demand rather than being allocated up front.
DISK_SIZE=64G

# The account created inside Windows. The password is a podman secret.
USERNAME=Docker

# Installation language, if the default English does not suit.
# LANGUAGE=Portuguese
# REGION=pt-BR
# KEYBOARD=pt-BR
