# HTTP basic auth on the viewer. Unique to this unit among the VMs here —
# the others have no login at all. The password is a podman secret.
PROTECT=Y
USERNAME=admin

# GPU acceleration. `Y` auto-detects a render node under /dev/dri; `N` falls
# back to software rendering, which upstream measures at 3–15 fps. Force a
# vendor with `intel`, `amd` or `nvidia` on a multi-GPU host.
GPU=Y
# RENDERNODE=/dev/dri/renderD128

# The mouse pointer is drawn by the host rather than the guest, which is what
# makes it feel responsive over the network.
FORCE_HOST_CURSOR=Y

# Keep the VM from sleeping. `N` lets ChromeOS suspend as it would on a laptop.
KEEP_AWAKE=N

# The VM's slice of the host. RAM_SIZE is reserved for its whole lifetime.
RAM_SIZE=4G
CPU_CORES=2
DISK_SIZE=32G
