# Which OS the VM installs on first boot. Set by install.py, which asks — the
# full list is in the README. It also accepts the URL of any ISO:
#   BOOT=https://example.com/whatever.iso
BOOT=alpine

# The VM's slice of the host. RAM_SIZE is reserved for the VM's whole
# lifetime, so leave the host enough to breathe.
RAM_SIZE=2G
CPU_CORES=2

# Virtual disk. It grows on demand rather than being allocated up front, but
# it lives in the volume, under your home directory.
DISK_SIZE=32G
