# Which Windows to install on first boot. It is downloaded from Microsoft's
# own servers the first time the container starts, and ignored afterwards —
# to change it later you delete the volume and start over.
# Options include: 11, 11e (LTSC/IoT), 10, 10e, 2025, 2022, 8e, 7u, xp, vista.
VERSION=11

# The VM's slice of the host. RAM_SIZE is reserved for the VM's whole
# lifetime, so leave the host enough to breathe.
RAM_SIZE=4G
CPU_CORES=2

# Virtual disk. It grows on demand rather than being allocated up front, but
# the install alone lands around 20 GB — and it lives in the volume, under
# your home directory.
DISK_SIZE=64G

# The account created inside Windows. The password is a podman secret, not
# set here.
USERNAME=Docker

# Installation language and keyboard, if the default English does not suit.
# LANGUAGE=Portuguese
# REGION=pt-BR
# KEYBOARD=pt-BR

# Where /shared lands inside Windows (\\host.lan\Data). Only WinApps reads it;
# the mount itself works without it.
HOME=/shared
