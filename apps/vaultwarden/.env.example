# The real access domain — used to generate attachment, WebAuthn/passkey and
# similar URLs correctly. Change it to the tailnet or local address as
# appropriate.
DOMAIN=https://vaultwarden.<your-tailnet>.ts.net
# Leave it "true" only until the first account exists — then switch it to
# "false" (see the Security section below).
SIGNUPS_ALLOWED=true
ENABLE_WEBSOCKET=true
