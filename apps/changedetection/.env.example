# The address the notification links point at. Without it they carry the
# container's own hostname, which resolves nowhere on your phone.
BASE_URL=https://changedetection.<your-tailnet>.ts.net

# A real Chrome for pages that only render with JavaScript, and for the visual
# element picker. Leave it commented out to fetch with plain HTTP requests,
# which is enough for most pages and costs no second container.
# PLAYWRIGHT_DRIVER_URL=ws://sockpuppet:3000

# How many checks run at the same time.
FETCH_WORKERS=10
