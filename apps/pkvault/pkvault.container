[Unit]
Description=PKVault (Pokémon storage and save editor, based on PKHeX)

[Container]
Image=ghcr.io/chnapy/pkvault:2.3.3
ContainerName=pkvault

Network=tsdproxy-net.network
PublishPort=8126:3000

Environment=BACKUP_FILE_COUNT_LIMIT=30

Volume=%h/.config/containers/volumes/pkvault/data:/pkvault:Z

ReadOnly=true
Tmpfs=/tmp:size=64M
Tmpfs=/run:size=8M
Tmpfs=/var/lib/nginx/tmp:size=128M,mode=1777
Tmpfs=/var/log/nginx:size=16M
DropCapability=ALL
AddCapability=CHOWN
AddCapability=DAC_OVERRIDE
AddCapability=SETGID
AddCapability=SETUID
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL curl -fsS -o /dev/null http://127.0.0.1:3000/api/settings || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=60s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=pkvault
Label=tsdproxy.port.web=443/https:3000/http
Label=tsdproxy.dash.icon=mdi/pokeball

Label=homepage.group=Personal
Label=homepage.name=PKVault
Label=homepage.icon=https://cdn.jsdelivr.net/gh/selfhst/icons/svg/pkvault.svg
Label=homepage.href=https://pkvault.${TAILNET}.ts.net
Label=homepage.description="Pokémon storage across every game's saves, with a shared Pokédex"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+[.][0-9]+[.][0-9]+$

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
