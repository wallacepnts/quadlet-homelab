[Unit]
Description=CookCLI (plain-text recipes, CookLang format)

[Container]
Image=ghcr.io/cooklang/cookcli
ContainerName=cookcli
WorkingDir=/recipes

Network=tsdproxy-net.network
PublishPort=9080:9080

Volume=%h/.config/containers/volumes/cookcli/recipes:/recipes:Z

ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
UserNS=keep-id
# check: ignore health no probe that runs inside this image has been measured yet; rule 24 asks for one.
PidsLimit=256
NoNewPrivileges=true

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=cookcli
Label=tsdproxy.dash.icon=sh/cookcli-light
Label=tsdproxy.port.web=443/https:9080/http

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
