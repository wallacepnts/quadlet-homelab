[Unit]
Description=CasaOS - a home server dashboard that talks to the Podman socket
Requires=podman.socket
After=podman.socket

[Container]
Image=ghcr.io/dockur/casa
ContainerName=casa

Network=tsdproxy-net.network
PublishPort=8129:8080

EnvironmentFile=%h/.config/containers/env/casa.env
Secret=casa-user,type=env,target=USER

# `:z` alone is not enough on SELinux: rule 16 of the conventions.
SecurityLabelType=container_runtime_t
Volume=%h/.config/containers/volumes/casa/data:/DATA:Z
Volume=%t/podman/podman.sock:/var/run/docker.sock:z

PodmanArgs=--cgroupns=host

StopTimeout=60

DropCapability=ALL
AddCapability=CHOWN
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
AddCapability=KILL
AddCapability=SETGID
AddCapability=SETUID
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL curl -sf -o /dev/null http://127.0.0.1:8080/v1/users/status || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=casa
Label=tsdproxy.port.web=443/https:8080/http

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
