{
  "$schema": "../app-schema.json",
  "title": "Zerobyte",
  "short_desc": { "en": "Backs up your apps' data.", "pt": "Faz backup dos dados dos seus apps." },
  "description": {
    "en": "Automates backups (via Restic) of every other service's data in this repository",
    "pt": "Automatiza backup (via Restic) dos dados de todos os outros serviços deste repositório"
  },
  "author": "nicotsx",
  "source": "https://github.com/nicotsx/zerobyte",
  "docs": "https://zerobyte.app",
  "license": "AGPL-3.0",
  "architectures": ["amd64", "arm64"],
  "category": "Monitoring",
  "secrets": { "zerobyte-app-secret": "rand-hex 32" },
  "config": {
    "backup-hook/zerobyte-backup-hook.py": "%h/.local/bin/zerobyte-backup-hook.py",
    "backup-hook/zerobyte-backup-hook.service": "%h/.config/systemd/user/zerobyte-backup-hook.service"
  },
  "backup": { "exclude": ["repositories"] },
  "units": { "zerobyte": { "image": "v{version}" } }
}
