[Unit]
Description=Stops a unit around Zerobyte's backup, on request

[Service]
Type=simple
# Which units this hook may stop. Without it nothing is allowed and every
# request gets a 404 — the safe default for an endpoint that stops services.
Environment=ZEROBYTE_HOOK_UNITS=any-sync-bundle
ExecStart=/usr/bin/python3 %h/.local/bin/zerobyte-backup-hook.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
