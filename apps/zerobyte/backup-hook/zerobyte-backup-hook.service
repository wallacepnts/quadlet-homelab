[Unit]
Description=Prepares a unit for Zerobyte's backup, on request

[Service]
Type=simple
# `unit[:mode]`, comma-separated. Empty allows nothing, which is the safe
# default for an endpoint that acts on services by name.
#   :sqlite  copy the databases with SQLite's online API, unit keeps running
#   :stop    stop before the copy and start after (the default)
# Use sqlite wherever it applies: it is consistent AND has no downtime.
Environment=ZEROBYTE_HOOK_UNITS=
ExecStart=/usr/bin/python3 %h/.local/bin/zerobyte-backup-hook.py
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
