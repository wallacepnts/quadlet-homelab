BASE_URL=https://zerobyte.<your-tailnet>.ts.net
TZ=America/Sao_Paulo
PORT=4096
RESTIC_HOSTNAME=<this-host-name>
# Only needed if you use pre/post-backup webhooks (see "Creating the backup
# jobs" — every origin used in the jobs has to be in this list, otherwise
# Zerobyte refuses to save the webhook URL)
WEBHOOK_ALLOWED_ORIGINS=http://host.containers.internal:8766
