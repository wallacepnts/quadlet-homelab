BASE_URL=https://zerobyte.<your-tailnet>.ts.net
TZ=America/Sao_Paulo
PORT=4096
RESTIC_HOSTNAME=<this-host-name>
# Only needed if you use pre/post-backup webhooks (see "Creating the backup
# jobs" — every origin used in the jobs has to be in this list, otherwise
# Zerobyte refuses to save the webhook URL)
# `host.containers.internal` only answers from Podman's default network. A
# container on a network of its own — every service here is on tsdproxy-net —
# times out against it under rootless Podman, and the job fails with
# `pre webhook failed`. Use the host's own address instead, the tailscale one
# for preference: it does not change with DHCP.
WEBHOOK_ALLOWED_ORIGINS=http://<ip-do-host>:8766,http://ntfy:2586
