# Closes signup. Leave it true only until you create your account on first
# access — the project's default is open, and a tailnet is not authentication.
HBOX_OPTIONS_ALLOW_REGISTRATION=false

# HomeBox queries the GitHub API on its own to announce new versions. Here
# that job belongs to wud (see ../wud/), so turn it off — one fewer pointless
# outbound connection.
HBOX_OPTIONS_CHECK_GITHUB_RELEASE=false

# The currency shown in item values.
HBOX_OPTIONS_CURRENCIES=BRL

# Attachment upload limit (MB). The default is 10; a scanned receipt or a
# PDF manual goes past that easily.
HBOX_WEB_MAX_UPLOAD_SIZE=50
