# Fetches a library on start, into the volume, if it is not there yet. Handy
# for the first one; after that it is simpler to drop files in the folder by
# hand, because this downloads on every start and a full Wikipedia is 100 GB.
#
# The catalogue is at https://library.kiwix.org — pick a file and paste its URL.
# DOWNLOAD=https://download.kiwix.org/zim/wikipedia/wikipedia_pt_all_nopic_2026-07.zim

# The port inside the container. The unit maps it, so changing this means
# changing the unit too.
PORT=8080
