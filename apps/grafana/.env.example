GF_SECURITY_ADMIN_USER=admin

# Signing up is off: this is one person's dashboard, and an open form on a
# reachable address is an account waiting to be made.
GF_USERS_ALLOW_SIGN_UP=false

# Grafana phones home for version checks and for the plugin catalogue.
GF_ANALYTICS_REPORTING_ENABLED=false
GF_ANALYTICS_CHECK_FOR_UPDATES=false
