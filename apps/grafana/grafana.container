[Unit]
Description=Grafana (dashboards over your metrics)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
NoNewPrivileges=true
User=472
PidsLimit=256

Image=docker.io/grafana/grafana:13.1.3
ContainerName=grafana
Network=tsdproxy-net.network
PublishPort=3004:3000

Volume=%h/.config/containers/volumes/grafana/data:/var/lib/grafana:Z
EnvironmentFile=%h/.config/containers/env/grafana.env
Secret=grafana-admin-password,type=env,target=GF_SECURITY_ADMIN_PASSWORD

HealthCmd=CMD-SHELL wget -q --spider http://127.0.0.1:3000/api/health || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=grafana
Label=tsdproxy.port.web=443/https:3000/http
Label=tsdproxy.dash.icon=sh/grafana

Label=homepage.group=Monitoring
Label=homepage.name=Grafana
Label=homepage.icon=grafana.svg
Label=homepage.href=https://grafana.${TAILNET}.ts.net
Label=homepage.description="Dashboards over whatever you point it at"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
