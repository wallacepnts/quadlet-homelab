[Unit]
Description=AdGuard Home (DNS ad-blocking)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
PidsLimit=256
Image=docker.io/adguard/adguardhome:v0.107.78
ContainerName=adguardhome
Network=tsdproxy-net.network
# One address, never 0.0.0.0: that one includes the container network's own
# gateway, where aardvark-dns answers, and publishing over it breaks name
# resolution between every container on the host — measured, and it took the
# whole host's inter-container DNS down with it.
#
# ${AGH_DNS_BIND} comes from ~/.config/environment.d/adguardhome.conf (rule 19
# of the conventions). Set it to the address the clients ask, usually the
# host's tailnet one. Without the file the unit will not start, which is the
# loud failure to prefer here.
PublishPort=${AGH_DNS_BIND}:53:53/tcp
PublishPort=${AGH_DNS_BIND}:53:53/udp
PublishPort=3006:3000/tcp

Volume=%h/.config/containers/volumes/adguardhome/conf:/opt/adguardhome/conf:Z
Volume=%h/.config/containers/volumes/adguardhome/work:/opt/adguardhome/work:Z

NoNewPrivileges=true

HealthCmd=CMD-SHELL wget -q --spider http://127.0.0.1:3000/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=adguardhome
Label=tsdproxy.port.web=443/https:3000/http
Label=tsdproxy.dash.icon=sh/adguard-home

Label=homepage.group="Network & Security"
Label=homepage.name="AdGuard Home"
Label=homepage.icon=adguard-home.svg
Label=homepage.href=https://adguardhome.${TAILNET}.ts.net
Label=homepage.description="Network-wide ad and tracker blocking over DNS"

Label=wud.watch=true
Label=wud.tag.include=^v[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
