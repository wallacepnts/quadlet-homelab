# The address the signing links carry. A link built from the container's own
# hostname opens nowhere on the phone of whoever has to sign.
HOST=docuseal.<your-tailnet>.ts.net

# SQLite, which is DocuSeal's own default and what this repository prefers.
# The official compose shows PostgreSQL; it is not needed for one household.
# DATABASE_URL=

# Sending the invitation by e-mail. Point it at the postfix in this repository
# if you run it; without a relay, the link has to be copied by hand.
# SMTP_ADDRESS=
# SMTP_PORT=1587
# SMTP_FROM=docuseal@example.com
