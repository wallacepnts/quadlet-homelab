# The address the desktop app is pointed at. It ends up in the links the
# server builds, so it is the tailnet name and not localhost.
APP_URL=https://ferdium.<your-tailnet>.ts.net

NODE_ENV=production

# SQLite, which is the project's default single-file deployment. DATA_DIR is
# where the database and the JWT keys land — the volume, so they survive.
DB_CONNECTION=sqlite
DATA_DIR=/data
DB_DATABASE=ferdium
JWT_USE_PEM=true

# Turn registration off once your own account exists. The dashboard is where
# you export and import your service list.
IS_REGISTRATION_ENABLED=true
IS_DASHBOARD_ENABLED=true

# Importing an existing Franz account. Off unless you have one to migrate.
CONNECT_WITH_FRANZ=false

# Password reset by e-mail. Point it at the postfix in this repository if you
# run it; without a working relay, reset mail simply never arrives.
MAIL_CONNECTION=smtp
SMTP_HOST=127.0.0.1
SMTP_PORT=2525
MAIL_SSL=false
MAIL_SENDER=noreply@ferdium.local
