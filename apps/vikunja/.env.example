# The address the frontend calls the API on, and what invitation links carry.
# Wrong here and the interface loads but every request fails.
VIKUNJA_SERVICE_PUBLICURL=https://vikunja.<your-tailnet>.ts.net

# SQLite, which is Vikunja's own default. PostgreSQL and MySQL are supported
# and unnecessary for a household.
VIKUNJA_DATABASE_TYPE=sqlite
VIKUNJA_DATABASE_PATH=/db/vikunja.db

# Attachments, separate from the database so a backup can tell them apart.
VIKUNJA_FILES_BASEPATH=/files

# Turn this off once your accounts exist, or anyone who reaches the tailnet can
# create one.
VIKUNJA_SERVICE_ENABLEREGISTRATION=true

# Reminders by e-mail. Point it at the postfix in this repository if you run
# it; without a relay the reminders only show up in the interface.
# VIKUNJA_MAILER_ENABLED=true
# VIKUNJA_MAILER_HOST=<host-ip>
# VIKUNJA_MAILER_PORT=1587
# VIKUNJA_MAILER_FROMEMAIL=vikunja@example.com
