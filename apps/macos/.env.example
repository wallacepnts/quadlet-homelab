# Which macOS the VM installs on first boot. Set by install.py, which asks —
# the full list is in the README.
VERSION=15

# The VM's slice of the host. RAM_SIZE is reserved for the VM's whole
# lifetime, so leave the host enough to breathe. Upstream's floor is 4 GB.
RAM_SIZE=4G
CPU_CORES=2

# Virtual disk. It grows on demand rather than being allocated up front, but
# it lives in the volume, under your home directory. Upstream asks for 64 GB
# of free space; the installer alone wants around 40 GB.
DISK_SIZE=64G
