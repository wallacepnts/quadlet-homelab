TZ=America/Sao_Paulo

VAULTZAP_INBOX=/inbox
VAULTZAP_IMPORTED_DIR=/inbox/.imported

#VAULTZAP_AFTER_IMPORT=move
#VAULTZAP_DATE_ORDER=DMY
#VAULTZAP_LOG_LEVEL=info
#VAULTZAP_ME=

# Turns authentication off entirely. Only when something in front of it already
# guards the port — the default is the login screen and needs nothing here.
#VAULTZAP_AUTH=off
