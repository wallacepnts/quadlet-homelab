# Engine. Left unset, the dashboard (Infrastructure > Engine) governs it and
# defaults to whatsapp-web.js — a real Chromium driving WhatsApp Web, which is
# what the 512M /tmp and the PidsLimit=2048 in the unit are sized for.
# `baileys` is a WebSocket client with no Chromium: far lighter, but a
# different feature set. A value here always wins over the dashboard.
# ENGINE_TYPE=whatsapp-web.js

# DATABASE_NAME must stay unset. With DATABASE_TYPE=sqlite a bare value here
# becomes the database file PATH, and under ReadOnly=true that is a
# SQLITE_CANTOPEN boot-loop (upstream #677). The default is
# /app/data/openwa.sqlite, inside the volume.

# Log level: error, warn, info, debug.
LOG_LEVEL=info

# Sessions are not resumed on start; open the dashboard and start them by
# hand. Set true once the linked accounts are stable.
AUTO_START_SESSIONS=false

# The browser upgrades http:// to https:// for the dashboard, which is right
# behind tsdproxy (it terminates TLS). Uncomment ONLY if you reach OpenWA
# directly at http://<host-ip>:2785 — otherwise the UI renders a blank white
# screen, because the non-TLS server cannot answer the upgraded requests
# (upstream #611, #731).
# CSP_UPGRADE_INSECURE_REQUESTS=false

# Webhook dispatch: how long to wait for your endpoint, and how long before
# retrying. Milliseconds.
WEBHOOK_TIMEOUT=10000
WEBHOOK_RETRY_DELAY=5000
