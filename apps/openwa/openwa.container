[Unit]
Description=OpenWA (WhatsApp API gateway)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=512M
DropCapability=ALL
AddCapability=CHOWN
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
AddCapability=SETGID
AddCapability=SETUID
NoNewPrivileges=true
PidsLimit=2048

Image=ghcr.io/rmyndharis/openwa:0.14.6
ContainerName=openwa
PublishPort=2785:2785

Environment=HOME=/tmp
Environment=XDG_CONFIG_HOME=/tmp/.config
Environment=XDG_CACHE_HOME=/tmp/.cache
Environment=DATABASE_TYPE=sqlite
Environment=STORAGE_TYPE=local
Environment=PLUGINS_DIR=/app/data/plugins

Volume=%h/.config/containers/volumes/openwa/data:/app/data:Z
EnvironmentFile=%h/.config/containers/env/openwa.env
Secret=openwa-master-key,type=env,target=API_MASTER_KEY
Secret=openwa-key-pepper,type=env,target=API_KEY_PEPPER

HealthCmd=CMD-SHELL curl -fsS -o /dev/null http://127.0.0.1:2785/api/health/ready || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=45s
Notify=healthy
Label=tsdproxy.enable=true
Label=tsdproxy.name=openwa
Label=tsdproxy.port.web=443/https:2785/http
Label=homepage.group=Self-Hosted
Label=homepage.name=OpenWA
Label=homepage.icon=https://cdn.jsdelivr.net/gh/rmyndharis/OpenWA@main/docs/logo/openwa.svg
Label=homepage.href=https://openwa.${TAILNET}.ts.net
Label=homepage.description="WhatsApp API gateway — sessions, webhooks and message sending over HTTP"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=180

[Install]
WantedBy=default.target
