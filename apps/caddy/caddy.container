[Unit]
Description=Caddy (TLS and routing for names of your own)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
PidsLimit=256

Image=docker.io/library/caddy:2.11.4-alpine
ContainerName=caddy
Network=tsdproxy-net.network
# Rootless Podman cannot expose a port below 1024. For https://name.casa with
# no port, raise the floor on the host and change these to 443:443 and 80:80:
#   echo 'net.ipv4.ip_unprivileged_port_start=80' | sudo tee /etc/sysctl.d/50-unprivileged-ports.conf
#   sudo sysctl --system
PublishPort=8443:443
PublishPort=8114:80

Volume=%h/.config/containers/volumes/caddy/config:/etc/caddy:ro,Z
Volume=%h/.config/containers/volumes/caddy/data:/data:Z
Volume=%h/.config/containers/volumes/caddy/state:/config:Z

HealthCmd=CMD-SHELL wget -q --spider http://127.0.0.1:2019/config/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
Notify=healthy

Label=homepage.group="Network & Security"
Label=homepage.name=Caddy
Label=homepage.icon=caddy.svg
Label=homepage.description="TLS and routing for names of your own, signed by a CA of your own"
Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+-alpine$

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
