[Unit]
Description=Collabora Online (document editing for ownCloud)

[Container]
Image=docker.io/collabora/code:26.04.4.2.1
ContainerName=collabora

Network=tsdproxy-net.network
PublishPort=8108:9980

EnvironmentFile=%h/.config/containers/env/collabora.env

DropCapability=ALL
AddCapability=SYS_CHROOT
# check: ignore health no probe that runs inside this image has been measured yet; rule 24 asks for one.
PidsLimit=512
NoNewPrivileges=true

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=collabora
Label=tsdproxy.port.web=443/https:9980/http
Label=tsdproxy.dash.icon=mdi/file-document-edit

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
