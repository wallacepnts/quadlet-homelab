# Who may embed the editor, as a regular expression: the dots are escaped and
# there is no trailing slash. Anything not listed here is answered with
# "unauthorized WOPI host", which in ownCloud shows up as a document that never
# opens.
aliasgroup1=https://owncloud\.<your-tailnet>\.ts\.net:443

# tsdproxy terminates TLS and forwards plain HTTP. Without the second flag
# Collabora builds its URLs as http:// and the browser blocks them as mixed
# content; without the first it tries to serve TLS itself, on a certificate
# nobody trusts.
extra_params=--o:ssl.enable=false --o:ssl.termination=true

# Spellchecking languages. Each one costs memory in every document process, so
# the default is deliberately short.
dictionaries=en_US pt_BR

# The admin console at /browser/dist/admin/admin.html. Leave both empty to keep
# it closed, which is the shipped default.
# username=admin
# password=
