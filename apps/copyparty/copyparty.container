[Unit]
Description=Copyparty (file server with browser uploads)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=256M
DropCapability=ALL
NoNewPrivileges=true
PidsLimit=256
User=1000
Image=ghcr.io/9001/copyparty-ac:1.20.20
ContainerName=copyparty
Network=tsdproxy-net.network
PublishPort=3923:3923
Volume=%h/.config/containers/volumes/copyparty/cfg:/cfg:Z
Volume=%h/.config/containers/volumes/copyparty/data:/w:Z

HealthCmd=CMD-SHELL wget -q -O /dev/null http://127.0.0.1:3923/ || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=15s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=copyparty
Label=tsdproxy.port.web=443/https:3923/http

Label=homepage.group=Self-Hosted
Label=homepage.name=Copyparty
Label=homepage.icon=copyparty.svg
Label=homepage.href=https://copyparty.${TAILNET}.ts.net
Label=homepage.description="File server with uploads from the browser, the phone or WebDAV"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
