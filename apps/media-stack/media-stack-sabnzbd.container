[Unit]
Description=SABnzbd (usenet client)

[Container]
DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETUID
AddCapability=SETGID
AddCapability=NET_BIND_SERVICE
PidsLimit=256
Image=lscr.io/linuxserver/sabnzbd:version-5.0.4
ContainerName=sabnzbd
Network=tsdproxy-net.network
PublishPort=8081:8080

Volume=%h/.config/containers/volumes/media-stack/sabnzbd/config:/config:Z
Volume=${MEDIA_DATA_DIR}:/data:Z
EnvironmentFile=%h/.config/containers/env/media-stack.env

HealthCmd=CMD-SHELL curl --silent --fail http://127.0.0.1:8080/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=sabnzbd
Label=tsdproxy.port.web=443/https:8080/http

Label=homepage.group=Downloads
Label=homepage.name=SABnzbd
Label=homepage.icon=sabnzbd.svg
Label=homepage.href=https://sabnzbd.${TAILNET}.ts.net
Label=homepage.description="Usenet client"
Label=wud.watch=true
Label=wud.tag.include=^version-[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
