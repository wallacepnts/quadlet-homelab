[Unit]
Description=Radarr (movie automation)

[Container]
DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETUID
AddCapability=SETGID
AddCapability=NET_BIND_SERVICE
PidsLimit=256
Image=lscr.io/linuxserver/radarr:6.3.0
ContainerName=radarr
Network=tsdproxy-net.network
PublishPort=7878:7878

Volume=%h/.config/containers/volumes/media-stack/radarr/config:/config:Z
Volume=${MEDIA_DATA_DIR}:/data:Z
EnvironmentFile=%h/.config/containers/env/media-stack.env

HealthCmd=CMD-SHELL curl --silent --fail http://127.0.0.1:7878/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=radarr
Label=tsdproxy.port.web=443/https:7878/http

Label=homepage.group=Media
Label=homepage.name=Radarr
Label=homepage.icon=radarr.svg
Label=homepage.href=https://radarr.${TAILNET}.ts.net
Label=homepage.description="Movie automation"

Label=wud.watch=true

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
