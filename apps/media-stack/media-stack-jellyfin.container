[Unit]
Description=Jellyfin (media server)

[Container]
PidsLimit=256
Image=docker.io/jellyfin/jellyfin:10.11.11
ContainerName=jellyfin
Network=tsdproxy-net.network
PublishPort=8096:8096
UserNS=keep-id

Volume=%h/.config/containers/volumes/media-stack/jellyfin/config:/config:Z
Volume=%h/.config/containers/volumes/media-stack/jellyfin/cache:/cache:Z
Volume=${MEDIA_DATA_DIR}:/data:ro,Z

HealthCmd=CMD-SHELL curl --silent --fail http://127.0.0.1:8096/health || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=40s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=jellyfin
Label=tsdproxy.port.web=443/https:8096/http

Label=homepage.group=Media
Label=homepage.name=Jellyfin
Label=homepage.icon=jellyfin.svg
Label=homepage.href=https://jellyfin.${TAILNET}.ts.net
Label=homepage.description="Self-hosted media server"

Label=wud.watch=true

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
