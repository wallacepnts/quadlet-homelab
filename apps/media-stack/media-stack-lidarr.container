[Unit]
Description=Lidarr (music automation)

[Container]
DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETUID
AddCapability=SETGID
AddCapability=NET_BIND_SERVICE
PidsLimit=256
Image=lscr.io/linuxserver/lidarr:3.1.0
ContainerName=lidarr
Network=tsdproxy-net.network
PublishPort=8686:8686

Volume=%h/.config/containers/volumes/media-stack/lidarr/config:/config:Z
Volume=${MEDIA_DATA_DIR}:/data:Z
EnvironmentFile=%h/.config/containers/env/media-stack.env

HealthCmd=CMD-SHELL curl --silent --fail http://127.0.0.1:8686/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=lidarr
Label=tsdproxy.port.web=443/https:8686/http

Label=homepage.group=Downloads
Label=homepage.name=Lidarr
Label=homepage.icon=lidarr.svg
Label=homepage.href=https://lidarr.${TAILNET}.ts.net
Label=homepage.description="Music automation"

Label=wud.watch=true

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
