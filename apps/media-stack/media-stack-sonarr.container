[Unit]
Description=Sonarr (TV series automation)

[Container]
DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETUID
AddCapability=SETGID
AddCapability=NET_BIND_SERVICE
PidsLimit=256
Image=lscr.io/linuxserver/sonarr:4.0.19
ContainerName=sonarr
Network=tsdproxy-net.network
PublishPort=8989:8989

Volume=%h/.config/containers/volumes/media-stack/sonarr/config:/config:Z
Volume=${MEDIA_DATA_DIR}:/data:Z
EnvironmentFile=%h/.config/containers/env/media-stack.env

HealthCmd=CMD-SHELL curl --silent --fail http://127.0.0.1:8989/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=sonarr
Label=tsdproxy.port.web=443/https:8989/http

Label=homepage.group=Downloads
Label=homepage.name=Sonarr
Label=homepage.icon=sonarr.svg
Label=homepage.href=https://sonarr.${TAILNET}.ts.net
Label=homepage.description="TV series automation"

Label=wud.watch=true

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
