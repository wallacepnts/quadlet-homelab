[Unit]
Description=Navidrome (music server)

[Container]
Image=ghcr.io/navidrome/navidrome:0.64.2
ContainerName=navidrome

Network=tsdproxy-net.network
PublishPort=4533:4533

EnvironmentFile=%h/.config/containers/env/media-stack.env

Volume=%h/.config/containers/volumes/media-stack/navidrome/data:/data:Z
Volume=${MEDIA_DATA_DIR}:/music:ro,Z

ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
User=1000
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL wget -q --spider http://127.0.0.1:4533/ping || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=navidrome
Label=tsdproxy.port.web=443/https:4533/http
Label=tsdproxy.dash.icon=sh/navidrome

Label=homepage.group=Media
Label=homepage.name=Navidrome
Label=homepage.icon=navidrome.svg
Label=homepage.href=https://navidrome.${TAILNET}.ts.net
Label=homepage.description="Music server with the Subsonic API, for any phone client"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
