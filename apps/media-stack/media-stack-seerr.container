[Unit]
Description=Seerr (media requests, the unified successor to Overseerr/Jellyseerr)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
PidsLimit=256
Image=ghcr.io/seerr-team/seerr:v3.4.1
ContainerName=seerr
PublishPort=5055:5055
UserNS=keep-id

Volume=%h/.config/containers/volumes/media-stack/seerr/config:/app/config:Z
EnvironmentFile=%h/.config/containers/env/media-stack.env

HealthCmd=CMD-SHELL wget --no-verbose --tries=1 --spider http://127.0.0.1:5055/api/v1/settings/public || exit 1
HealthInterval=15s
HealthTimeout=3s
HealthRetries=3
HealthStartPeriod=20s
Notify=healthy
Label=tsdproxy.enable=true
Label=tsdproxy.name=seerr
Label=tsdproxy.port.web=443/https:5055/http
Label=homepage.group=Media
Label=homepage.name=Seerr
Label=homepage.icon=seerr.svg
Label=homepage.href=https://seerr.${TAILNET}.ts.net
Label=homepage.description="Movie and TV requests (integrates with Sonarr/Radarr/Jellyfin)"

Label=wud.watch=true

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
