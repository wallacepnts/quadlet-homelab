# Which sender domains this relay accepts. Without one of the two lines below
# Postfix refuses every message. Prefer naming the domain; the empty-sender
# form accepts anything the port can reach.
#ALLOWED_SENDER_DOMAINS=example.com
ALLOW_EMPTY_SENDER_DOMAINS=true

# The name this server gives in HELO and in the Received headers. A generic one
# is a spam signal on the receiving side.
POSTFIX_myhostname=homelab.local

# Where to hand the mail over. Empty means Postfix delivers it itself, which
# needs outbound port 25 open and a domain whose SPF, DKIM and reverse DNS all
# agree — most connections do not have that, and the mail is filed as spam.
#RELAYHOST=[smtp.gmail.com]:587
#RELAYHOST_USERNAME=you@gmail.com
#POSTFIX_smtp_tls_security_level=encrypt

# Who may hand messages in. Default is the container's own subnet; widen it only
# to the network you trust, because whoever reaches this port sends as you.
#POSTFIX_mynetworks=127.0.0.0/8,10.0.0.0/8
