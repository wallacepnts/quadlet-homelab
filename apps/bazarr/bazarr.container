[Unit]
Description=Bazarr (subtitles)

[Container]
Image=lscr.io/linuxserver/bazarr
ContainerName=bazarr

Network=tsdproxy-net.network
PublishPort=6767:6767

EnvironmentFile=%h/.config/containers/env/bazarr.env

Volume=%h/.config/containers/volumes/bazarr/config:/config:Z
Volume=${MEDIA_DATA_DIR}:/data:z

DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETUID
AddCapability=SETGID
AddCapability=NET_BIND_SERVICE
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL curl --silent --fail http://127.0.0.1:6767/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=bazarr
Label=tsdproxy.port.web=443/https:6767/http

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
