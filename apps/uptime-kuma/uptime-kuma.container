[Unit]
Description=Uptime Kuma (uptime monitor)

[Container]
Image=docker.io/louislam/uptime-kuma
ContainerName=uptime-kuma

Network=tsdproxy-net.network
PublishPort=3001:3001

Volume=%h/.config/containers/volumes/uptime-kuma/data:/app/data:Z

ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
User=1000
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL extra/healthcheck || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=uptime-kuma
Label=tsdproxy.port.web=443/https:3001/http

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
