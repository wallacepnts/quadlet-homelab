[Unit]
Description=Invio (self-hosted invoicing)

[Container]
DropCapability=ALL
NoNewPrivileges=true
PidsLimit=256

Image=ghcr.io/kittendevv/invio:v2.1.1
ContainerName=invio
Network=tsdproxy-net.network
PublishPort=8106:8000
Volume=%h/.config/containers/volumes/invio/data:/app/data:Z
EnvironmentFile=%h/.config/containers/env/invio.env
Secret=invio-admin-pass,type=env,target=ADMIN_PASS
Secret=invio-jwt-secret,type=env,target=JWT_SECRET
HealthCmd=CMD-SHELL curl -s -o /dev/null http://127.0.0.1:8000/ || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=25s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=invio
Label=tsdproxy.port.web=443/https:8000/http

Label=homepage.group=Personal
Label=homepage.name=Invio
Label=homepage.icon=si-invoiceninja
Label=homepage.href=https://invio.${TAILNET}.ts.net
Label=homepage.description="Invoicing and invoice tracking, with no external service"

Label=wud.watch=true
Label=wud.tag.include=^v[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
