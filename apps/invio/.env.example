# The administrator user. The PASSWORD and the JWT secret do not live here —
# they go in as podman secrets (see the README).
ADMIN_USER=admin

# SvelteKit's CSRF protection: it has to be the EXACT URL you reach it
# through, otherwise every POST is refused. Replace <your-tailnet>.
ORIGIN=https://invio.<your-tailnet>.ts.net

# SQLite inside the volume.
DATABASE_PATH=/app/data/invio.db
