[Unit]
Description=Retrom (game library and emulation)

[Container]
NoNewPrivileges=true
PidsLimit=512
DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETGID
AddCapability=SETUID

Image=ghcr.io/jmberesford/retrom-service:0.8.4
ContainerName=retrom
Network=tsdproxy-net.network
PublishPort=5101:5101

Volume=%h/.config/containers/volumes/retrom/config:/app/config:Z
Volume=%h/.config/containers/volumes/retrom/data:/app/data:Z
Volume=%h/.config/containers/volumes/retrom/library:/app/library:Z
EnvironmentFile=%h/.config/containers/env/retrom.env

HealthCmd=CMD-SHELL curl -fsS -o /dev/null http://127.0.0.1:5101/ || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=180s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=retrom
Label=tsdproxy.port.web=443/https:5101/http
Label=tsdproxy.dash.icon=mdi/gamepad-variant

Label=homepage.group=Media
Label=homepage.name=Retrom
Label=homepage.icon=https://api.iconify.design/mdi/gamepad-variant.svg?color=%%23888888
Label=homepage.href=https://retrom.${TAILNET}.ts.net
Label=homepage.description="Game library for emulation, played in the browser or a client"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
