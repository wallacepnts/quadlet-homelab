# The uid/gid the files end up owned by. The entrypoint runs usermod with
# these, so they must match whoever owns the library on the host — check with
# `id -u` and `id -g`.
PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# The entrypoint chowns the three volumes on every start. On a large library
# that is minutes of disk churn for nothing, since the owner does not change.
# SKIP_RECURSIVE_CHOWN=true
