[Unit]
Description=Ollama (local LLMs, Open WebUI's backend)

[Container]
Image=docker.io/ollama/ollama
ContainerName=ollama

Network=tsdproxy-net.network
Network=openwebui-net.network
PublishPort=11434:11434

Volume=%h/.config/containers/volumes/openwebui/ollama:/root/.ollama:Z

DropCapability=ALL
PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL ollama list || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=ollama
Label=tsdproxy.port.web=443/https:11434/http

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
