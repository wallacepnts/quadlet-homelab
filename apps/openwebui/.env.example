# The name of the Ollama container in this repository, on the same network
# (ollama-net) — resolved by Podman's internal DNS.
OLLAMA_BASE_URL=http://ollama:11434

# Web search through the searxng service, if you run it. Its settings.yml has
# to list `json` under search.formats, or SearXNG answers 403 here.
# ENABLE_RAG_WEB_SEARCH=True
# RAG_WEB_SEARCH_ENGINE=searxng
# SEARXNG_QUERY_URL=http://searxng:8080/search?q=<query>
