[Unit]
Description=ExcaliDash (Excalidraw dashboard)
After=excalidash-backend.service
Requires=excalidash-backend.service

[Container]
NoNewPrivileges=true
PidsLimit=256
DropCapability=ALL
AddCapability=CHOWN
AddCapability=NET_BIND_SERVICE
AddCapability=SETGID
AddCapability=SETUID

Image=docker.io/zimengxiong/excalidash-frontend:0.5.1
ContainerName=excalidash
Network=excalidash-net.network
Network=tsdproxy-net.network
PublishPort=8016:80

Environment=BACKEND_URL=excalidash-backend:8000

HealthCmd=CMD-SHELL wget -q --spider http://127.0.0.1:80/ || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=20s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=excalidash
Label=tsdproxy.port.web=443/https:80/http
Label=tsdproxy.dash.icon=sh/excalidraw

Label=homepage.group=Productivity
Label=homepage.name=ExcaliDash
Label=homepage.icon=excalidraw.svg
Label=homepage.href=https://excalidash.${TAILNET}.ts.net
Label=homepage.description="Excalidraw drawings, organised and shared from one place"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
