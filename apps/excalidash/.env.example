# SQLite in the volume. The project also speaks Postgres; this deployment does
# not run one, and the drawings are small.
DATABASE_PROVIDER=sqlite
DATABASE_URL=file:/app/prisma/dev.db
PORT=8000
NODE_ENV=production

# local: accounts live here. See the README for the Authentik variant.
AUTH_MODE=local

# Only with a proxy that sanitises forwarded headers. tsdproxy does not, so
# leaving it false is what keeps a spoofed X-Forwarded-For from being trusted.
TRUST_PROXY=false
