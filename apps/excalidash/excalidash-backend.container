[Unit]
Description=ExcaliDash backend (API and SQLite)

[Container]
NoNewPrivileges=true
PidsLimit=256
DropCapability=ALL
AddCapability=CHOWN
AddCapability=DAC_OVERRIDE
AddCapability=FOWNER
AddCapability=SETGID
AddCapability=SETUID

Image=docker.io/zimengxiong/excalidash-backend:0.5.1
ContainerName=excalidash-backend
Network=excalidash-net.network

Volume=%h/.config/containers/volumes/excalidash/data:/app/prisma:Z
EnvironmentFile=%h/.config/containers/env/excalidash.env
Secret=excalidash-jwt-secret,type=env,target=JWT_SECRET
Secret=excalidash-csrf-secret,type=env,target=CSRF_SECRET

HealthCmd=CMD-SHELL node -e "require('http').get('http://127.0.0.1:8000/health', r => process.exit(r.statusCode === 200 ? 0 : 1))" || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=40s
Notify=healthy

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
