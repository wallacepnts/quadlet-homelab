[Unit]
Description=Faved (bookmarks with nested tags)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
Tmpfs=/var/run:size=16M
Tmpfs=/var/log/apache2:size=32M
DropCapability=ALL
AddCapability=NET_BIND_SERVICE
NoNewPrivileges=true
User=33
PidsLimit=256

Image=docker.io/denho/faved:2.10.0
ContainerName=faved
Network=tsdproxy-net.network
PublishPort=8111:80

Volume=%h/.config/containers/volumes/faved/storage:/var/www/html/storage:Z

HealthCmd=CMD-SHELL curl -fsS -o /dev/null http://127.0.0.1:80/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=faved
Label=tsdproxy.port.web=443/https:80/http
Label=tsdproxy.dash.icon=sh/faved-light

Label=homepage.group=Personal
Label=homepage.name=Faved
Label=homepage.icon=https://cdn.jsdelivr.net/gh/selfhst/icons/svg/faved.svg
Label=homepage.href=https://faved.${TAILNET}.ts.net
Label=homepage.description="Bookmarks with nested tags, kept on your own server"
Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
