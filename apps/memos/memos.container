[Unit]
Description=Memos (self-hosted quick notes)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
User=1000
PidsLimit=256
Image=docker.io/neosmemo/memos:0.30.0
ContainerName=memos
Network=tsdproxy-net.network
PublishPort=5230:5230
Volume=%h/.config/containers/volumes/memos/data:/var/opt/memos:Z
EnvironmentFile=%h/.config/containers/env/memos.env
HealthCmd=CMD-SHELL wget -q --spider http://127.0.0.1:5230/healthz || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=15s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=memos
Label=tsdproxy.port.web=443/https:5230/http

Label=homepage.group=Productivity
Label=homepage.name=Memos
Label=homepage.icon=memos.svg
Label=homepage.href=https://memos.${TAILNET}.ts.net
Label=homepage.description="Quick notes, self-hosted and markdown-native"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
