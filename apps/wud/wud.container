[Unit]
Description=What's Up Docker - image update monitor
Requires=podman.socket
After=podman.socket

[Container]
Image=docker.io/getwud/wud
ContainerName=wud

Network=tsdproxy-net.network
PublishPort=8085:3000

Environment=WUD_AUTH_ADMIN_USER=admin
EnvironmentFile=%h/.config/containers/env/wud.env
Secret=wud-admin-password,type=env,target=WUD_AUTH_ADMIN_PASSWORD

SecurityLabelType=container_runtime_t
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro,z
Volume=%h/.config/containers/volumes/wud/store:/store:Z

ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
PidsLimit=128
NoNewPrivileges=true

HealthCmd=CMD-SHELL wget -q --spider http://127.0.0.1:3000/ || exit 1
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=wud
Label=tsdproxy.port.web=443/https:3000/http

[Service]
Restart=always

[Install]
WantedBy=default.target
