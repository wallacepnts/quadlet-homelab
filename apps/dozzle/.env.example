# Read-only by default: without this Dozzle offers buttons that stop and
# restart containers, and the socket is mounted `:ro` so they would fail
# halfway. Set to false only if you also drop the `:ro` from the unit.
DOZZLE_NO_ACTIONS=true

# The filter that decides which containers show up. Empty means all of them.
# DOZZLE_FILTER=name=media-stack

# One user, so the logs are not open to whoever reaches the tailnet. Leave it
# off and anyone who opens the page reads everything.
# DOZZLE_AUTH_PROVIDER=simple
