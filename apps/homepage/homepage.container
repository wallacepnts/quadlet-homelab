[Unit]
Description=Homepage - services dashboard
Requires=podman.socket
After=podman.socket

[Container]
Image=ghcr.io/gethomepage/homepage:latest
ContainerName=homepage
AutoUpdate=registry

Network=tsdproxy-net.network
PublishPort=3000:3000

EnvironmentFile=%h/.config/containers/env/homepage.env

# `:z` alone is not enough on SELinux: rule 16 of the conventions.
SecurityLabelType=container_runtime_t
Volume=%t/podman/podman.sock:/var/run/docker.sock:ro,z
Volume=%h/.config/containers/volumes/homepage/config:/app/config:ro,Z
Volume=%h/.config/containers/volumes/homepage/icons:/app/public/icons:ro,Z

ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
PidsLimit=128
NoNewPrivileges=true

HealthCmd=CMD-SHELL wget -q --spider http://127.0.0.1:3000/ || exit 1
HealthInterval=10s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=10s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=homepage
Label=tsdproxy.port.web=443/https:3000/http

[Service]
Restart=always

[Install]
WantedBy=default.target
