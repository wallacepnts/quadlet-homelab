{
  "spec": 2,
  "id": "nginx",
  "title": "nginx",
  "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/nginx.svg",
  "tagline": {
    "en": "A static file server",
    "pt": "Servidor de arquivos estáticos"
  },
  "category": "Network & Security",
  "links": {
    "docs": "https://nginx.org/en/docs/"
  },
  "notes": {
    "en": "Open `http://<host-ip>:8103` or `https://nginx.<your-tailnet>.ts.net`.",
    "pt": "Abrir `http://<ip-do-host>:8103` ou `https://nginx.<your-tailnet>.ts.net`."
  },
  "config": {
    "conf.d/default.conf": {
      "value": "%h/.config/containers/volumes/nginx/conf.d/default.conf",
      "note": "Read by the app, never written by it: the destination is inside a volume, so it cannot be derived from the unit the way an .env can. The server block. nginx rewrites its own default at start, so this is the copy that has to be in place before it comes up."
    }
  },
  "units": {
    "nginx": {
      "upstream": "registry:^1\\.\\d*[02468]\\.\\d+-alpine$"
    }
  }
}
