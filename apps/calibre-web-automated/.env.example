# PUID/PGID of the user running Podman (the same owner as the volumes below,
# otherwise the image cannot write to them) — check with `id -u`/`id -g`.
PUID=1000
PGID=1000
TZ=America/Sao_Paulo

# Only needed if you use Hardcover as a metadata provider
# (https://docs.hardcover.app/api/getting-started/)
# HARDCOVER_TOKEN=

# true if /calibre-library is on a network share (NFS/SMB) — it turns WAL
# off and swaps inotify for polling, avoiding broken locks and permissions in
# that scenario (default: false)
NETWORK_SHARE_MODE=false
