# It has to match the address used in the browser exactly (NextAuth
# validates it for cookies/CSRF) — a single canonical URL.
NEXTAUTH_URL=https://karakeep.<your-tailnet>.ts.net

# Once your account exists, consider locking down new signups (a personal
# instance has no reason to stay open)
# DISABLE_SIGNUPS=true

# Enables automatic AI tagging (optional) — see
# https://docs.karakeep.app/configuration for other providers (a local
# Ollama, etc.)
# OPENAI_API_KEY=

# How many crawling jobs run in parallel (default: 1)
# CRAWLER_NUM_WORKERS=1
