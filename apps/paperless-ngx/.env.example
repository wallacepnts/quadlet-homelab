# UID/GID of the user running Podman — the image chowns the volumes
# internally (consume/ above all) to that user. Adjust it before the first
# start (`id -u`/`id -g`).
USERMAP_UID=1000
USERMAP_GID=1000

TZ=America/Sao_Paulo
PAPERLESS_TIME_ZONE=America/Sao_Paulo

# The default OCR language plus extra languages to install — the image only
# ships eng/deu/ita/spa/fra by default; any other one (such as por) has to
# appear in BOTH variables to work: PAPERLESS_OCR_LANGUAGES installs the
# Tesseract package on the first start, and PAPERLESS_OCR_LANGUAGE is what is
# actually used for recognition. Setting only one of the two does not work.
PAPERLESS_OCR_LANGUAGE=por
PAPERLESS_OCR_LANGUAGES=por

# Only needed if you expose it publicly outside the tailnet
# PAPERLESS_URL=https://paperless.example.com
