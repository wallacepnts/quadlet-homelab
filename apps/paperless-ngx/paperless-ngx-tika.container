[Unit]
Description=Paperless-ngx Tika (Office text/metadata extraction)

[Container]
Image=docker.io/apache/tika:3.3.1.0
ContainerName=paperless-ngx-tika

Network=paperless-ngx-net.network
NetworkAlias=tika

ReadOnly=true
Tmpfs=/tmp:size=256M
DropCapability=ALL
PidsLimit=256
NoNewPrivileges=true

HealthCmd=["CMD", "bash", "-c", "exec 3<>/dev/tcp/127.0.0.1/9998 && { echo 'GET /version HTTP/1.0'; echo; } >&3 && head -n1 <&3 | grep -q ' 200 '"]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=20s
Notify=healthy

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
