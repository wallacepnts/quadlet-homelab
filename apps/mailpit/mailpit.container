[Unit]
Description=Mailpit (SMTP server and email viewer for testing)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
NoNewPrivileges=true
User=1000
PidsLimit=256

Image=docker.io/axllent/mailpit:v1.30.7
ContainerName=mailpit
Network=tsdproxy-net.network
PublishPort=8025:8025
PublishPort=1025:1025

Volume=%h/.config/containers/volumes/mailpit/data:/data:Z
EnvironmentFile=%h/.config/containers/env/mailpit.env
Secret=mailpit-ui-auth,type=env,target=MP_UI_AUTH

HealthCmd=["/mailpit", "readyz"]
HealthInterval=30s
HealthTimeout=5s
HealthRetries=3
HealthStartPeriod=15s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=mailpit
Label=tsdproxy.port.web=443/https:8025/http

Label=homepage.group=Tools
Label=homepage.name=Mailpit
Label=homepage.icon=https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/mailpit.svg
Label=homepage.href=https://mailpit.${TAILNET}.ts.net
Label=homepage.description="Catches the email your apps send, to read in the browser"

Label=wud.watch=true
Label=wud.tag.include=^v[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
