# MP_DATA_FILE was renamed: current Mailpit reads MP_DATABASE and warns on the
# old name. Without it the messages live in memory and vanish on restart.
MP_DATABASE=/data/mailpit.db

# Oldest messages are pruned past this. 0 keeps everything until the disk says
# otherwise.
MP_MAX_MESSAGES=500

# Mailpit checks GitHub for a newer release on every start. This repository
# pins the tag and qh-updates does the checking.
MP_DISABLE_VERSION_CHECK=true
