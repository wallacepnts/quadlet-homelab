[Unit]
Description=ntfy (push notification server)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
NoNewPrivileges=true
PidsLimit=256
User=1000

Image=docker.io/binwiederhier/ntfy:v2.27.0
ContainerName=ntfy
Network=tsdproxy-net.network
PublishPort=2586:2586
Exec=serve

Environment=NTFY_LISTEN_HTTP=:2586
Environment=NTFY_BEHIND_PROXY=true
Environment=NTFY_CACHE_FILE=/var/cache/ntfy/cache.db
Environment=NTFY_ATTACHMENT_CACHE_DIR=/var/cache/ntfy/attachments
Environment=NTFY_AUTH_FILE=/var/lib/ntfy/user.db
Environment=NTFY_AUTH_DEFAULT_ACCESS=deny-all
EnvironmentFile=%h/.config/containers/env/ntfy.env

Volume=%h/.config/containers/volumes/ntfy/cache:/var/cache/ntfy:Z
Volume=%h/.config/containers/volumes/ntfy/lib:/var/lib/ntfy:Z
HealthCmd=CMD-SHELL wget -q -O /dev/null http://127.0.0.1:2586/v1/health || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=15s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=ntfy
Label=tsdproxy.port.web=443/https:2586/http

Label=homepage.group=Monitoring
Label=homepage.name=ntfy
Label=homepage.icon=ntfy.svg
Label=homepage.href=https://ntfy.${TAILNET}.ts.net
Label=homepage.description="Push notification server — where the uptime-kuma, wud and zerobyte alerts go"

Label=wud.watch=true
Label=wud.tag.include=^v[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
