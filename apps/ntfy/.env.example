# The server's canonical URL. ntfy builds attachment and web push links from
# it — point it at the tailnet address, not at IP:port, otherwise the
# generated links do not open from outside the host.
NTFY_BASE_URL=https://ntfy.<your-tailnet>.ts.net

# How long messages stay in the cache. An offline client only receives what
# is still here; 12h is the project's default.
NTFY_CACHE_DURATION=12h

# Attachments. 0 turns file upload off — enable it only if you will use it,
# because it is what makes the volume grow.
NTFY_ATTACHMENT_TOTAL_SIZE_LIMIT=1G
NTFY_ATTACHMENT_FILE_SIZE_LIMIT=15M
NTFY_ATTACHMENT_EXPIRY_DURATION=3h
