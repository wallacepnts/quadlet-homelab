[Unit]
Description=Toolbx Arch Linux (interactive shell)

[Container]
Image=quay.io/toolbx/arch-toolbox@sha256:b71b4446ac8aa3a334f34a2d24ae1a681f3559e59f20878d0f128681d3254d4f
ContainerName=toolbx-arch
Exec=sleep infinity
WorkingDir=/work

Environment=HOME=/work

Volume=%h/.config/containers/volumes/toolbx/arch:/work:Z

UserNS=keep-id
PidsLimit=1024
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
