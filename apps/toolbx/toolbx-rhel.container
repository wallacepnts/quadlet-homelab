[Unit]
Description=Toolbx RHEL 10 (interactive shell)

[Container]
Image=registry.access.redhat.com/ubi10/toolbox:10.2
ContainerName=toolbx-rhel
Exec=sleep infinity
WorkingDir=/work

Environment=HOME=/work

Volume=%h/.config/containers/volumes/toolbx/rhel:/work:Z

UserNS=keep-id
PidsLimit=1024
NoNewPrivileges=true

[Service]
Restart=always
TimeoutStartSec=90

[Install]
WantedBy=default.target
