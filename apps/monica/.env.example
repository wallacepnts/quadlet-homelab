# The real access URL (tsdproxy/tailnet) — used in generated links
# (invitations, password resets).
APP_URL=https://monica.<your-tailnet>.ts.net

# Trusts the X-Forwarded-* header from whatever proxy sits in front —
# without it Laravel does not know the connection arrived over HTTPS
# (tsdproxy terminates TLS first) and generates every link and asset as
# http://, which the browser blocks as "mixed content" on an https:// page
# (that is why the UI does not load properly through tsdproxy without this
# variable).
# The variable name was verified in practice: it is APP_TRUSTED_PROXIES, not
# TRUSTED_PROXIES (that "obvious" name does not exist and is silently
# ignored — see config/trustedproxy.php in the image itself).
APP_TRUSTED_PROXIES=*

# No SMTP configured — it writes emails (invitations, password resets) to
# the log instead of really sending them. Set MAIL_HOST/MAIL_PORT/
# MAIL_USERNAME/MAIL_PASSWORD if you need real delivery.
MAIL_MAILER=log
