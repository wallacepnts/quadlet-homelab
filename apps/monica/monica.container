[Unit]
Description=Monica (personal CRM)

[Container]
Image=ghcr.io/monicahq/monica-next:main@sha256:8a02508cbdcfcc44d5bb3b456ba30cdc9fe9c0a17b2702043a4dbbd0c55300ed
ContainerName=monica

Network=tsdproxy-net.network
PublishPort=9092:80

Environment=DB_DATABASE=/var/www/html/storage/database.sqlite
EnvironmentFile=%h/.config/containers/env/monica.env
Secret=monica-app-key,type=env,target=APP_KEY

Volume=%h/.config/containers/volumes/monica/storage:/var/www/html/storage:Z

PidsLimit=256
NoNewPrivileges=true

HealthCmd=CMD-SHELL curl -fsS http://127.0.0.1:80/login || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=5
HealthStartPeriod=60s
Notify=healthy

Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=monica
Label=tsdproxy.port.web=443/https:80/http
Label=tsdproxy.dash.icon=sh/monica

Label=homepage.group=Personal
Label=homepage.name=Monica
Label=homepage.icon=monica.svg
Label=homepage.href=https://monica.${TAILNET}.ts.net
Label=homepage.description="Personal CRM — relationships, contacts, reminders"

# check: ignore wud — floating tag (`main`), nothing to compare between runs.

[Service]
Restart=always
TimeoutStartSec=120

[Install]
WantedBy=default.target
