# Every variable is optional — with none of them the image uses its defaults
# (NGINX_PORT=80, WEB_APP_PORT=3000, MENU_VERSION=latest). Left empty on
# purpose; see netbootxyz.container for the host port mapping.

# Pins the netboot.xyz menu to a specific version instead of the latest
# available (e.g. 2.0.84). Without it, the menu builder updates itself on
# every start, regardless of the image tag.
# MENU_VERSION=2.0.84
