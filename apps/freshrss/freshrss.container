[Unit]
Description=FreshRSS (RSS/Atom feed aggregator)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
AddCapability=CHOWN
AddCapability=SETUID
AddCapability=SETGID
AddCapability=NET_BIND_SERVICE
PidsLimit=256
Image=ghcr.io/freshrss/freshrss:1.29.1-alpine
ContainerName=freshrss
PublishPort=8104:80

Volume=%h/.config/containers/volumes/freshrss/data:/var/www/FreshRSS/data:Z
EnvironmentFile=%h/.config/containers/env/freshrss.env
HealthCmd=CMD-SHELL php cli/health.php || exit 1
HealthInterval=30s
HealthTimeout=10s
HealthRetries=3
HealthStartPeriod=30s
Notify=healthy
Label=tsdproxy.enable=true
Label=tsdproxy.name=freshrss
Label=tsdproxy.port.web=443/https:80/http
Label=homepage.group=Self-Hosted
Label=homepage.name=FreshRSS
Label=homepage.icon=freshrss.svg
Label=homepage.href=https://freshrss.${TAILNET}.ts.net
Label=homepage.description="Self-hosted RSS/Atom feed aggregator"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+-alpine$

[Service]
Restart=always
TimeoutStartSec=60

[Install]
WantedBy=default.target
