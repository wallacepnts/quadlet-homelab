[Unit]
Description=wger (workout planning and tracking)

[Container]
ReadOnly=true
Tmpfs=/tmp:size=64M
DropCapability=ALL
NoNewPrivileges=true
PidsLimit=256

Image=docker.io/wger/server:2.6.0
ContainerName=wger
Network=tsdproxy-net.network
PublishPort=8102:8000
Environment=USE_CELERY=False
Environment=DJANGO_CACHE_BACKEND=django.core.cache.backends.locmem.LocMemCache
Environment=DJANGO_CACHE_LOCATION=wger-cache
Environment=DJANGO_DEBUG=False
EnvironmentFile=%h/.config/containers/env/wger.env
Secret=wger-secret-key,type=env,target=SECRET_KEY

Volume=%h/.config/containers/volumes/wger/db:/home/wger/db:Z
Volume=%h/.config/containers/volumes/wger/static:/home/wger/static:Z
Volume=%h/.config/containers/volumes/wger/media:/home/wger/media:Z
HealthCmd=CMD-SHELL wget -q -O /dev/null http://127.0.0.1:8000/ || exit 1
HealthInterval=30s
HealthTimeout=15s
HealthRetries=5
HealthStartPeriod=120s
Notify=healthy
Label=tsdproxy.enable=true
Label=tsdproxy.autodetect=true
Label=tsdproxy.name=wger
Label=tsdproxy.port.web=443/https:8000/http
Label=homepage.group=Self-Hosted
Label=homepage.name=wger
Label=homepage.icon=wger.svg
Label=homepage.href=https://wger.${TAILNET}.ts.net
Label=homepage.description="Workout planning and tracking, with an exercise database and body measurements"

Label=wud.watch=true
Label=wud.tag.include=^[0-9]+.[0-9]+.[0-9]+$

[Service]
Restart=always
TimeoutStartSec=300

[Install]
WantedBy=default.target
