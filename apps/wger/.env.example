# SQLite instead of the official compose's Postgres (rule 22 of the
# conventions). Four slashes: three from the URI plus the root of the
# absolute path.
PS_DATABASE_URI=sqlite:////home/wger/db/database.sqlite

# The hosts Django accepts. Replace <your-tailnet> with your own domain.
ALLOWED_HOSTS=wger.<your-tailnet>.ts.net,127.0.0.1,localhost
CSRF_TRUSTED_ORIGINS=https://wger.<your-tailnet>.ts.net

# Closes signup. Leave it False only until your account exists.
ALLOW_REGISTRATION=False
ALLOW_GUEST_USERS=False

# Syncing of the public exercise/ingredient database. Without celery this
# does not run in the background — you can pull on demand with
# `podman exec wger python3 manage.py sync-exercises` (see the README).
SYNC_EXERCISES_CELERY=False
SYNC_EXERCISE_IMAGES_CELERY=False
SYNC_EXERCISE_VIDEOS_CELERY=False
SYNC_INGREDIENTS_CELERY=False
CACHE_API_EXERCISES_CELERY=False
