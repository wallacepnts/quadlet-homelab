{
  "title": "Immich",
  "category": "Media",
  "secrets": {
    "immich-db-password": "rand-base64 24"
  },
  "backup": {
    "exclude": [
      "upload/thumbs",
      "upload/encoded-video",
      "ml-cache",
      "ml-dotcache",
      "redis"
    ]
  },
  "units": {
    "immich": {
      "upstream": "immich-app/immich",
      "image": "v{version}"
    },
    "immich-machine-learning": {
      "upstream": "immich-app/immich",
      "image": "v{version}"
    },
    "immich-postgres": {
      "upstream": "compose:immich-app/immich:docker/docker-compose.yml"
    },
    "immich-redis": {
      "upstream": "compose:immich-app/immich:docker/docker-compose.yml"
    }
  },
  "short_desc": {
    "en": "Back up and browse your photos and videos.",
    "pt": "Faça backup e navegue pelas suas fotos e vídeos."
  },
  "description": {
    "en": "Photo and video backup and organisation, with face recognition and smart search",
    "pt": "Backup e organização de fotos/vídeos, com reconhecimento facial e busca smart"
  },
  "docs": "https://immich.app",
  "source": "https://github.com/immich-app/immich",
  "author": "immich-app"
}
