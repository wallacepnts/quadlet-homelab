{
  "spec": 2,
  "id": "immich",
  "title": "Immich",
  "icon": "https://cdn.jsdelivr.net/gh/homarr-labs/dashboard-icons/svg/immich.svg",
  "tagline": {
    "en": "Photo and video backup and organisation, with face recognition and smart search",
    "pt": "Backup e organização de fotos/vídeos, com reconhecimento facial e busca smart"
  },
  "category": "Media",
  "license": "AGPL-3.0.",
  "links": {
    "docs": "https://immich.app"
  },
  "notes": {
    "en": "Open `http://<host-ip>:2283` or `https://immich.<your-tailnet>.ts.net`.",
    "pt": "Abrir `http://<ip-do-host>:2283` ou `https://immich.<your-tailnet>.ts.net`."
  },
  "secrets": {
    "immich-db-password": "rand-base64 24"
  },
  "backup": {
    "exclude": [
      "upload/thumbs",
      "upload/encoded-video",
      "ml-cache",
      "ml-dotcache",
      "redis"
    ],
    "note": "Thumbnails, transcodes and the caches are regenerated by Immich's own jobs (Administration > Jobs); the originals, the database and the settings are not."
  },
  "units": {
    "immich": {
      "upstream": "immich-app/immich",
      "image": "v{version}"
    },
    "immich-machine-learning": {
      "upstream": "immich-app/immich",
      "image": "v{version}"
    },
    "immich-postgres": {
      "upstream": "compose:immich-app/immich:docker/docker-compose.yml"
    },
    "immich-redis": {
      "upstream": "compose:immich-app/immich:docker/docker-compose.yml"
    }
  }
}
