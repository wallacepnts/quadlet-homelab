{
  "spec": 2,
  "title": "Immich",
  "tagline": "Photo and video backup and organisation, with face recognition and smart search",
  "category": "Media",
  "links": {
    "docs": "https://immich.app"
  },
  "secrets": {
    "immich-db-password": "rand-base64 24"
  },
  "backup": {
    "exclude": [
      "upload/thumbs",
      "upload/encoded-video",
      "ml-cache",
      "ml-dotcache",
      "redis"
    ]
  },
  "units": {
    "immich": {
      "upstream": "immich-app/immich",
      "image": "v{version}"
    },
    "immich-machine-learning": {
      "upstream": "immich-app/immich",
      "image": "v{version}"
    },
    "immich-postgres": {
      "upstream": "compose:immich-app/immich:docker/docker-compose.yml"
    },
    "immich-redis": {
      "upstream": "compose:immich-app/immich:docker/docker-compose.yml"
    }
  }
}
